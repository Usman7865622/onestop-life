generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum RoleKey {
  CUSTOMER
  DOCTOR
  VET
  BLOOD_BANK_STAFF
  PHARMACY
  SELLER
  DELIVERY_AGENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Locale {
  en
  ur
}

enum VerificationType {
  DOCTOR
  VET
  PHARMACY
  BLOOD_BANK
  SELLER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentRecordStatus {
  PENDING
  REQUIRES_ACTION
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum FacilityType {
  HOSPITAL
  CLINIC
  LAB
  BLOOD_BANK
  PHARMACY
}

enum AppointmentType {
  IN_PERSON
  VIDEO
}

enum LabBookingStatus {
  BOOKED
  SAMPLE_COLLECTED
  REPORT_READY
  DELIVERED
  CANCELLED
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum BloodRequestStatus {
  OPEN
  FULFILLED
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum FamilyRelationship {
  SELF
  CHILD
  PARENT
  SPOUSE
  SIBLING
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ---------- Identity ----------

model User {
  id              String     @id @default(uuid()) @db.Uuid
  phone           String?    @unique // E.164 when supplied; email accounts may add a phone later
  email           String?    @unique
  googleSub       String?    @unique // Google OAuth subject id for "Continue with Google"
  passwordHash    String?
  name            String?
  locale          Locale     @default(en)
  status          UserStatus @default(ACTIVE)
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  walletBalanceMinor Int    @default(0)

  roles                UserRole[]
  refreshTokens        RefreshToken[]
  familyMembers        FamilyMember[] @relation("AccountFamilyMembers")
  verificationRequests VerificationRequest[] @relation("Applicant")
  reviewedRequests     VerificationRequest[] @relation("Reviewer")
  auditLogs            AuditLog[]
  orders               Order[]
  addresses            Address[]
  walletTransactions   WalletTransaction[]
  products             Product[] @relation("SellerProducts")
  doctorProfile        DoctorProfile?
  patientAppointments  Appointment[] @relation("PatientAppointments")
  prescriptions        Prescription[] @relation("PatientPrescriptions")
  labBookings          LabBooking[]
  bloodRequests        BloodRequest[]
  reviews              Review[] @relation("ReviewAuthor")

  @@map("users")
}

model UserRole {
  userId    String   @db.Uuid
  role      RoleKey
  grantedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid // all tokens descended from one login share a family
  tokenHash String    @unique // SHA-256 of the raw token; the raw token is never stored
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------- Family profiles ----------
// One account (the account holder) manages patient profiles for the whole
// household: themselves plus children, parents, spouse, siblings. Profiles
// live inside the account — no separate logins. Every account has exactly one
// isSelf profile ("Myself"), created at signup and backfilled for existing
// users by the family_profiles migration. Removal is a soft delete
// (deletedAt) so appointment/order history stays intact for records.

model FamilyMember {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @db.Uuid // the account holder who manages this profile
  fullName     String
  relationship FamilyRelationship
  dateOfBirth  DateTime?          @db.Date
  gender       Gender?
  isSelf       Boolean            @default(false)
  deletedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation("AccountFamilyMembers", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@map("family_members")
}

// ---------- Professional / seller verification ----------

model VerificationRequest {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @db.Uuid
  type             VerificationType
  licenseNumber    String
  licenseAuthority String // e.g. the council or authority that issued the licence
  documentKey      String // storage key of the uploaded licence document (file service comes later)
  notes            String?
  status           VerificationStatus @default(PENDING)
  reviewedById     String?            @db.Uuid
  reviewNote       String?
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user       User  @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("Reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, type])
  @@map("verification_requests")
}

// ---------- Audit ----------

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
// Add to schema.prisma

enum ImportJobStatus {
  PENDING
  VALIDATING
  VALIDATED
  APPLYING
  COMPLETED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model ImportJob {
  id           String          @id @default(cuid())
  filename     String
  status       ImportJobStatus @default(PENDING)
  totalRows    Int             @default(0)
  validRows    Int             @default(0)
  invalidRows  Int             @default(0)
  summary      Json?           // { toCreate: number, toUpdate: number, errorsCount: number }
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  rows         ImportRow[]
}

model ImportRow {
  id          String    @id @default(cuid())
  jobId       String
  job         ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowNumber   Int
  rawPayload  Json
  isValid     Boolean   @default(false)
  action      String?   // 'CREATE' | 'UPDATE' | 'REJECT'
  sku         String?
  errors      Json?     // Array of validation error strings
}

model OutboxEvent {
  id          String       @id @default(cuid())
  aggregate   String       // 'PRODUCT' | 'CATEGORY' | 'INVENTORY'
  aggregateId String
  eventType   String       // 'UPSERT' | 'DELETE'
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
}

model Product {
  id               String   @id @default(uuid()) @db.Uuid
  sellerId         String?  @db.Uuid
  nameEn           String
  nameUr           String?
  priceMinor       Int
  unit             String   @default("item")
  category         String?
  imageUrl         String?
  inStock          Boolean  @default(true)
  genericName      String?
  brandName        String?
  strength         String?
  form             String?
  therapeuticClass String?
  requiresRx       Boolean  @default(false)
  packSize         String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orderItems OrderItem[]
  prescriptionItems PrescriptionItem[]
  seller     User? @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([createdAt])
  @@index([sellerId])
  @@index([therapeuticClass])
  @@map("products")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotalMinor   Int
  discountMinor   Int         @default(0)
  shippingMinor   Int         @default(0)
  totalMinor      Int
  currency        String      @default("PKR")
  discountCode    String?
  shippingName    String
  shippingPhone   String
  shippingAddress String
  shippingCity       String?
  shippingPostalCode String?
  addressLabel       String?
  deliveryNotes      String?
  deliverySpeed      String   @default("STANDARD")
  deliverySlot       String?
  giftWrap           Boolean  @default(false)
  giftMessage        String?
  emiPlan            String?
  returnRequested    Boolean   @default(false)
  returnReason       String?
  returnRequestedAt  DateTime?
  requiresRx            Boolean             @default(false)
  prescriptionKey       String?
  prescriptionId        String?             @db.Uuid // digital prescription issued on OneStop that covers this order's Rx items
  prescriptionStatus    PrescriptionStatus?
  prescriptionNotes     String?
  prescriptionReviewedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescription Prescription? @relation("OrderDigitalPrescription", fields: [prescriptionId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments PaymentRecord[]
  refunds  Refund[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  orderId         String  @db.Uuid
  productId       String  @db.Uuid
  productName     String
  priceMinor      Int
  quantity        Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model PaymentRecord {
  id                String               @id @default(uuid()) @db.Uuid
  orderId           String               @db.Uuid
  method            String
  status            PaymentRecordStatus  @default(PENDING)
  amountMinor       Int
  providerReference String?              @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  order  Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId, createdAt])
  @@map("payment_records")
}

model Refund {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @db.Uuid
  paymentId       String?      @db.Uuid
  amountMinor     Int
  reason          String?
  status          RefundStatus @default(PENDING)
  providerReference String?
  createdAt       DateTime     @default(now())

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment PaymentRecord? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("refunds")
}

model DiscountCode {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  type        DiscountType
  value       Int
  active      Boolean      @default(true)
  maxUses     Int?
  usedCount   Int          @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime     @default(now())

  @@map("discount_codes")
}

// ---------- Healthcare: facilities, doctors, appointments (Phase 1B) ----------

model Facility {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  type        FacilityType
  address     String
  city        String
  phone       String?
  timings     String?
  isEmergency Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  doctors      DoctorFacility[]
  appointments Appointment[]
  labTests     LabTest[]
  labBookings  LabBooking[]
  availabilitySlots AvailabilitySlot[]

  @@index([city])
  @@index([type])
  @@map("facilities")
}

model DoctorProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  speciality        String
  qualifications    String?
  experienceYears   Int      @default(0)
  feeMinor          Int
  languages         String[] @default([])
  about             String?
  isBookable        Boolean  @default(true)
  pmdcNumber        String?
  consultationCount Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilities   DoctorFacility[]
  appointments Appointment[]
  prescriptions Prescription[]
  reviews      Review[]
  availabilitySlots AvailabilitySlot[]

  @@index([speciality])
  @@map("doctor_profiles")
}

model DoctorFacility {
  doctorProfileId String @db.Uuid
  facilityId      String @db.Uuid

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  facility      Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([doctorProfileId, facilityId])
  @@map("doctor_facilities")
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  patientId       String            @db.Uuid
  doctorProfileId String            @db.Uuid
  facilityId      String?           @db.Uuid
  startsAt        DateTime
  endsAt          DateTime
  type            AppointmentType   @default(IN_PERSON)
  status          AppointmentStatus @default(PENDING)
  feeMinor        Int
  reason          String?
  patientName     String
  patientPhone    String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patient       User          @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  facility      Facility?     @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  review        Review?
  prescription  Prescription?

  @@index([doctorProfileId, startsAt])
  @@index([patientId, startsAt])
  @@index([status, startsAt])
  @@map("appointments")
}

// ---------- Post-visit: digital prescriptions (Phase 1C) ----------
// A doctor issues one prescription against a COMPLETED appointment. Items can
// reference catalogue medicines (productId) for 1-tap reordering; free-text
// rows cover anything else. The same document can satisfy the checkout Rx gate
// for its covered medicines — the pharmacist still verifies before dispatch.

model Prescription {
  id              String   @id @default(uuid()) @db.Uuid
  appointmentId   String   @db.Uuid @unique
  patientId       String   @db.Uuid
  doctorProfileId String   @db.Uuid
  diagnosis       String?
  notes           String?
  createdAt       DateTime @default(now())

  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient       User           @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)
  doctorProfile DoctorProfile  @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  items         PrescriptionItem[]
  orders        Order[]        @relation("OrderDigitalPrescription")

  @@index([patientId, createdAt])
  @@index([doctorProfileId, createdAt])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String   @id @default(uuid()) @db.Uuid
  prescriptionId String   @db.Uuid
  productId      String?  @db.Uuid // matched catalogue medicine; null for free-text rows
  name           String
  dosage         String?
  frequency      String?
  durationDays   Int?
  qty            Int      @default(1)
  notes          String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([prescriptionId])
  @@map("prescription_items")
}

// ---------- Doctor weekly availability slots (schedule templates) ----------
model AvailabilitySlot {
  id              String    @id @default(uuid()) @db.Uuid
  doctorProfileId String    @db.Uuid
  facilityId      String?   @db.Uuid
  weekday         Int       // 0=Sunday..6=Saturday
  startTime       String    // "09:00" Karachi wall-clock
  endTime         String    // "17:00" Karachi wall-clock
  slotMinutes     Int       @default(30)
  isActive        Boolean   @default(true)
  validFrom       DateTime?
  validUntil      DateTime?

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  facility      Facility?     @relation(fields: [facilityId], references: [id], onDelete: SetNull)

  @@index([doctorProfileId, weekday])
  @@map("availability_slots")
}

model Review {
  id              String   @id @default(uuid()) @db.Uuid
  appointmentId   String   @unique @db.Uuid
  doctorProfileId String   @db.Uuid
  userId          String   @db.Uuid
  rating          Int
  title           String?
  text            String
  createdAt       DateTime @default(now())

  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  user          User          @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([doctorProfileId, createdAt])
  @@map("reviews")
}
model LabTest {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  priceMinor  Int
  sampleType  String
  reportHours Int
  facilityId  String   @db.Uuid
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facility Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  bookings LabBooking[]

  @@index([facilityId])
  @@index([isActive])
  @@map("lab_tests")
}

model LabBooking {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  testId      String           @db.Uuid
  facilityId  String           @db.Uuid
  scheduledAt DateTime
  address     String
  patientName String
  phone       String
  status      LabBookingStatus @default(BOOKED)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  test     LabTest  @relation(fields: [testId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledAt])
  @@index([facilityId, scheduledAt])
  @@index([status])
  @@map("lab_bookings")
}

model BloodRequest {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @db.Uuid
  bloodGroup   BloodGroup
  units        Int
  city         String
  hospitalName String?
  urgency      String             @default("NORMAL")
  status       BloodRequestStatus @default(OPEN)
  contactPhone String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, bloodGroup, city])
  @@map("blood_requests")
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
  @@map("contact_messages")
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  label      String
  name       String
  phone      String
  address    String
  city       String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model WalletTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  amountMinor Int
  type        String
  reference   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}
