NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://platform:platform_dev_password@localhost:5432/platform?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false
COOKIE_SECURE=false

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-1
OTP_HMAC_SECRET=change-me-change-me-change-me-change-me-2

JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=100
OTP_MAX_PER_HOUR=100

# Used only by the seed script to create the first admin
ADMIN_PHONE=03001234567

# Optional: enables the AI shopping assistant on the product catalogue
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4.1-mini
