{
  "name": "platform",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "prisma:generate": "pnpm --filter api prisma:generate",
    "prisma:push": "pnpm --filter api prisma:push",
    "prisma:migrate": "pnpm --filter api prisma:migrate",
    "prisma:deploy": "pnpm --filter api prisma:deploy",
    "dev:api": "pnpm --filter api start:dev",
    "build:api": "pnpm --filter api build",
    "test:api": "pnpm --filter api test",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "start:web": "pnpm --filter web start"
  }
}
